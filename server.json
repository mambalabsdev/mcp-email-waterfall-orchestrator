{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.mambabuilt/mcp-email-waterfall-orchestrator",
  "description": "Finds and verifies work emails on your own provider keys, with real per-provider spend.",
  "version": "1.0.2",
  "repository": {
    "url": "https://github.com/mambalabsdev/mcp-email-waterfall-orchestrator",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mambalabsdev/mcp-email-waterfall-orchestrator",
      "version": "1.0.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APIFY_TOKEN",
          "description": "Apify API token from https://console.apify.com/account/integrations",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
